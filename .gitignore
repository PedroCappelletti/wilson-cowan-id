# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Datos y resultados pesados (se regeneran)
data/raw/*
data/processed/*
results/figures/*
results/models/*
!**/.gitkeep

# Formatos de datos / modelos
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.h5

# Excepcion: los datasets y checkpoints del escalado si se versionan. Pesan
# 5,3 MB y 13 KB, y son lo unico que ata cada numero publicado a sus bytes.
!data/processed/uncertain/
!data/processed/uncertain/act1.npz
!data/processed/uncertain/refrac1.npz
# Versiones con ruido del eje 6: derivadas de act1 con semilla fija, pero se
# guardan igual porque la comparabilidad muestra a muestra depende de ellas.
!data/processed/uncertain/act1_n01.npz
!data/processed/uncertain/act1_n05.npz
!data/processed/uncertain/refrac1_n01.npz
!data/processed/uncertain/refrac1_n05.npz
# Dataset ampliado con validación (esc_gen_ampliado.py), 43 MB entre los seis.
!data/processed/uncertain/act1_amp.npz
!data/processed/uncertain/act1_amp_n01.npz
!data/processed/uncertain/act1_amp_n05.npz
!data/processed/uncertain/refrac1_amp.npz
!data/processed/uncertain/refrac1_amp_n01.npz
!data/processed/uncertain/refrac1_amp_n05.npz
!results/escalado/models/
!results/escalado/models/*.pt

# IDE / OS
.vscode/
.idea/
.DS_Store

# caches de herramientas
.ua/
.claude/

# Auxiliares de LaTeX
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
