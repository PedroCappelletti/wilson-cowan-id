# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Datos y resultados pesados (se regeneran)
data/raw/*
data/processed/*
results/figures/*
results/models/*
!**/.gitkeep

# Formatos de datos / modelos
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.h5

# Excepcion: los datasets y checkpoints del escalado si se versionan. Pesan
# 5,3 MB y 13 KB, y son lo unico que ata cada numero publicado a sus bytes.
!data/processed/uncertain/
!data/processed/uncertain/act1.npz
!data/processed/uncertain/refrac1.npz
!results/escalado/models/
!results/escalado/models/*.pt

# IDE / OS
.vscode/
.idea/
.DS_Store

# caches de herramientas
.ua/
.claude/
